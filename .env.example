# Copy to .env and set private demo passwords. Never commit .env.
CAMPUSX_DB_PATH=./data/campusx.sqlite

# Used only to create the initial demo accounts when the database is empty.
# Use strong, private values. These credentials are never shipped to the browser.
CAMPUSX_DEMO_STUDENT_PASSWORD=replace-with-a-demo-student-password
CAMPUSX_DEMO_ADMIN_PASSWORD=replace-with-a-demo-admin-password
CAMPUSX_DEMO_FACULTY_PASSWORD=replace-with-a-demo-faculty-password
